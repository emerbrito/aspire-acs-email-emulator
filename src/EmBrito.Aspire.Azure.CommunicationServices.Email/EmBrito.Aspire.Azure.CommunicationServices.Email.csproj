<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>Azure Communication Services Email Emulator Client for Aspire</Title>
    <Description>Application package for the Azure Communication Services Email Emulator for Aspire. Registers Microsoft's EmailClient from Aspire configuration.</Description>
    <PackageTags>aspire;emulator;azure;communication-services;email;client</PackageTags>
    <PackageReadmeFile>EmBrito.Aspire.Azure.CommunicationServices.Email.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\EmBrito.Aspire.Azure.CommunicationServices.Email.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmBrito.Aspire.Azure.CommunicationServices.Email.Tests" />
  </ItemGroup>
</Project>
